{
  "info": {
    "name": "Tink — diagnostyka Sandbox",
    "description": "Wyłącznie diagnostyka istniejącego użytkownika aplikacji Tink Sandbox. Nie testuje pełnego backendu 4Money. Nie tworzy użytkowników, nie importuje danych i nie odnawia zgód. Tokeny, kody i URL-e wyłącznie lokalnie. Instrukcja: notes/POSTMAN.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "10 — Token aplikacji",
      "description": "Uruchom przed folderem 20 lub 30. Wymagane lokalne sekrety aplikacji Sandbox.",
      "item": [
        {
          "name": "11 — Uzyskaj Client Access Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{tinkApiBaseUrl}}/api/v1/oauth/token",
            "description": "Wyłącznie aplikacja Sandbox. Scope authorization:grant; nie tworzy użytkownika. Resetuje poprzednie tokeny i kody diagnostyczne. Tokeny nie są wypisywane przez skrypty.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{tinkClientId}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{tinkClientSecret}}",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "authorization:grant",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "function stop(message) {",
                  "    pm.test('Warunki wstępne', function () { throw new Error(message); });",
                  "    pm.execution.setNextRequest(null);",
                  "    pm.execution.skipRequest();",
                  "}",
                  "function need(names) {",
                  "    const missing = names.filter(function (name) {",
                  "        const value = pm.environment.get(name);",
                  "        return typeof value !== 'string' || !value.trim() || value.includes('{{');",
                  "    });",
                  "    if (missing.length) stop('Uzupełnij lokalne środowisko: ' + missing.join(', '));",
                  "}",
                  "function clear(names) { names.forEach(function (name) { pm.environment.unset(name); }); }",
                  "clear([\"tinkClientAccessToken\", \"tinkClientTokenExpiresAt\", \"tinkConsentCode\", \"tinkConsentAccessToken\", \"tinkConsentTokenExpiresAt\", \"tinkDelegatedCode\", \"tinkAuthorizationUrl\", \"tinkDiagnosticState\"]);",
                  "need(['tinkApiBaseUrl', 'tinkClientId', 'tinkClientSecret']);",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "function check(name, predicate) {",
                  "    let ok = false;",
                  "    try { ok = Boolean(predicate()); } catch (_) { /* Do not expose response values. */ }",
                  "    pm.test(name, function () { pm.expect(ok, name).to.equal(true); });",
                  "    if (!ok) {",
                  "        pm.execution.setNextRequest(null);",
                  "        throw new Error('Przerwano: ' + name);",
                  "    }",
                  "}",
                  "function jsonResponse(status, noStore) {",
                  "    check('Oczekiwany status HTTP ' + status, function () { return pm.response.code === status; });",
                  "    check('Odpowiedź JSON', function () {",
                  "        return /application\\/(?:problem\\+)?json/i.test(pm.response.headers.get('Content-Type') || '');",
                  "    });",
                  "    if (noStore) check('Cache-Control: no-store', function () {",
                  "        return /(?:^|,)\\s*no-store\\s*(?:,|$)/i.test(pm.response.headers.get('Cache-Control') || '');",
                  "    });",
                  "    let body;",
                  "    check('Poprawny dokument JSON', function () { body = pm.response.json(); return body !== null; });",
                  "    return body;",
                  "}",
                  "function saveToken(body, tokenKey, expiryKey) {",
                  "    check('Niepusty token i dodatnie expires_in', function () {",
                  "        return typeof body.access_token === 'string' && body.access_token.trim().length > 0",
                  "            && Number.isFinite(body.expires_in) && body.expires_in > 0;",
                  "    });",
                  "    pm.environment.set(tokenKey, body.access_token);",
                  "    const seconds = body.expires_in - Math.min(60, body.expires_in * 0.1);",
                  "    pm.environment.set(expiryKey, String(Date.now() + seconds * 1000));",
                  "}",
                  "const body = jsonResponse(200, false);",
                  "saveToken(body, 'tinkClientAccessToken', 'tinkClientTokenExpiresAt');",
                  "})();"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
