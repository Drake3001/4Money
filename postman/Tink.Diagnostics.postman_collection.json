                  "        pm.execution.setNextRequest(null);",
                  "        throw new Error('Przerwano: ' + name);",
                  "    }",
                  "}",
                  "function jsonResponse(status, noStore) {",
                  "    check('Oczekiwany status HTTP ' + status, function () { return pm.response.code === status; });",
                  "    check('Odpowiedź JSON', function () {",
                  "        return /application\\/(?:problem\\+)?json/i.test(pm.response.headers.get('Content-Type') || '');",
                  "    });",
                  "    if (noStore) check('Cache-Control: no-store', function () {",
                  "        return /(?:^|,)\\s*no-store\\s*(?:,|$)/i.test(pm.response.headers.get('Cache-Control') || '');",
                  "    });",
                  "    let body;",
                  "    check('Poprawny dokument JSON', function () { body = pm.response.json(); return body !== null; });",
                  "    return body;",
                  "}",
                  "const body = jsonResponse(200, false);",
                  "check('Niepusty kod delegowany', function () { return typeof body.code === 'string' && body.code.trim().length > 0; });",
                  "let url;",
                  "check('Poprawny bazowy Tink Link URL', function () {",
                  "    url = new URL(pm.environment.get('tinkLinkUrl'));",
                  "    return url.protocol === 'https:' && url.pathname === '/1.0/transactions/connect-accounts';",
                  "});",
                  "const state = pm.variables.replaceIn('{{$guid}}');",
                  "const params = {",
                  "    client_id: pm.environment.get('tinkClientId'), authorization_code: body.code,",
                  "    redirect_uri: pm.environment.get('tinkDiagnosticRedirectUri'), market: pm.environment.get('tinkMarket'),",
                  "    locale: pm.environment.get('tinkLocale'), refreshable_items: pm.environment.get('tinkRefreshableItems'), state: state",
                  "};",
                  "Object.keys(params).forEach(function (key) { url.searchParams.set(key, params[key]); });",
                  "pm.environment.set('tinkDelegatedCode', body.code);",
                  "pm.environment.set('tinkDiagnosticState', state);",
                  "pm.environment.set('tinkAuthorizationUrl', url.toString());",
                  "pm.execution.setNextRequest(null);",
                  "})();"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
