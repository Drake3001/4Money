    {
      "name": "30 — Tink Link (osobno, ręcznie)",
      "description": "Oddzielny kod delegowany i redirect diagnostyczny; nie korzysta z callbacku backendu.",
      "item": [
        {
          "name": "31 — Deleguj Tink Link i zbuduj URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{tinkApiBaseUrl}}/api/v1/oauth/authorization-grant/delegate",
            "description": "Osobna ręczna ścieżka diagnostyczna dla istniejącego Tink User. Po sukcesie otwórz lokalną tinkAuthorizationUrl w przeglądarce. Redirect musi być dopuszczony w Tink Console; nie używaj callbacku 4Money. Nie wymieniaj otrzymanego kodu na token użytkownika.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tinkClientAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "user_id",
                  "value": "{{tinkUserId}}",
                  "type": "text"
                },
                {
                  "key": "actor_client_id",
                  "value": "{{tinkActorClientId}}",
                  "type": "text"
                },
                {
                  "key": "id_hint",
                  "value": "{{tinkIdHint}}",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "{{tinkDelegatedScopes}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "function stop(message) {",
                  "    pm.test('Warunki wstępne', function () { throw new Error(message); });",
                  "    pm.execution.setNextRequest(null);",
                  "    pm.execution.skipRequest();",
                  "}",
                  "function need(names) {",
                  "    const missing = names.filter(function (name) {",
                  "        const value = pm.environment.get(name);",
                  "        return typeof value !== 'string' || !value.trim() || value.includes('{{');",
                  "    });",
                  "    if (missing.length) stop('Uzupełnij lokalne środowisko: ' + missing.join(', '));",
                  "}",
                  "function clear(names) { names.forEach(function (name) { pm.environment.unset(name); }); }",
                  "function validToken(tokenKey, expiryKey) {",
                  "    need([tokenKey, expiryKey]);",
                  "    if (!(Number(pm.environment.get(expiryKey)) > Date.now()))",
                  "        stop('Token wygasł lub ma niepoprawną datę. Uruchom ponownie odpowiednią sekwencję tokenu.');",
                  "}",
                  "clear(['tinkDelegatedCode', 'tinkAuthorizationUrl', 'tinkDiagnosticState']);",
                  "    need(['tinkApiBaseUrl', 'tinkUserId']);",
                  "validToken('tinkClientAccessToken', 'tinkClientTokenExpiresAt');",
                  "    need(['tinkActorClientId', 'tinkIdHint', 'tinkLinkUrl', 'tinkDiagnosticRedirectUri', 'tinkMarket', 'tinkLocale', 'tinkRefreshableItems', 'tinkDelegatedScopes']);",
                  "    if (pm.environment.get('tinkActorClientId') === pm.environment.get('tinkClientId'))",
                  "        stop('ActorClientId Tink Link musi być odrębny od ClientId aplikacji.');",
                  "    let redirect;",
                  "    try { redirect = new URL(pm.environment.get('tinkDiagnosticRedirectUri')); } catch (_) { stop('Niepoprawny redirect URI.'); }",
                  "    if (redirect.pathname.split('/').filter(Boolean).join('/') === 'api/banking/tink/callback')",
                  "        stop('Diagnostyka bez lokalnej próby nie może używać callbacku 4Money.');",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
