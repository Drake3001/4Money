                  "        return item && typeof item.credentialsId === 'string' && item.credentialsId.trim().length > 0",
                  "            && typeof item.status === 'string' && item.status.trim().length > 0",
                  "            && (item.sessionExpiryDate == null || (Number.isSafeInteger(item.sessionExpiryDate)",
