                  "        throw new Error('Przerwano: ' + name);",
                  "    }",
                  "}",
                  "function jsonResponse(status, noStore) {",
                  "    check('Oczekiwany status HTTP ' + status, function () { return pm.response.code === status; });",
                  "    check('Odpowiedź JSON', function () {",
                  "        return /application\\/(?:problem\\+)?json/i.test(pm.response.headers.get('Content-Type') || '');",
                  "    });",
                  "    if (noStore) check('Cache-Control: no-store', function () {",
                  "        return /(?:^|,)\\s*no-store\\s*(?:,|$)/i.test(pm.response.headers.get('Cache-Control') || '');",
                  "    });",
                  "    let body;",
                  "    check('Poprawny dokument JSON', function () { body = pm.response.json(); return body !== null; });",
                  "    return body;",
                  "}",
                  "const body = jsonResponse(200, false);",
                  "check('Niepusty kod grantu użytkownika', function () { return typeof body.code === 'string' && body.code.trim().length > 0; });",
                  "pm.environment.set('tinkConsentCode', body.code);",
                  "})();"
                ]
              }
            }
          ],
          "response": []
        },
