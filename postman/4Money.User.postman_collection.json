    {
      "name": "20 — Logowanie i sesja",
      "description": "Po loginie tokeny zapisują się w środowisku. Logout uruchom po operacjach chronionych.",
      "item": [
        {
          "name": "21 — Zaloguj",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users/login",
            "description": "Wymaga aktywnego konta z potwierdzonym e-mailem. Błędne dane: 401. Nieaktywne konto z poprawnym hasłem: 403, Account is deactivated. Nowy login zastępuje poprzednią sesję. Przed wysłaniem usuwa stare tokeny lokalne.\n\nUruchamiaj ręcznie przez Send. Runner zatrzymuje się po każdym żądaniu. JSON jest kodowany ze zmiennych środowiska przez skrypt wstępny. Odpowiedzi nie są eksportowane jako przykłady.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{userLogin}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "pm.execution.setNextRequest(null);",
                  "const required = [\"baseUrl\", \"userLogin\", \"userPassword\"];",
                  "const missing = required.filter(function (key) { const value = pm.environment.get(key); return typeof value !== 'string' || !value.trim() || value.includes('{{'); });",
                  "if (missing.length) {",
                  "    pm.test('Uzupełnione zmienne ?rodowiska', function () { throw new Error('Uzupełnij: ' + missing.join(', ')); });",
                  "    pm.execution.skipRequest();",
                  "    return;",
                  "}",
                  "pm.environment.unset('fourMoneyAccessToken');",
                  "pm.environment.unset('fourMoneyRefreshToken');",
                  "pm.request.body.update(JSON.stringify({",
                  "    \"login\": pm.environment.get('userLogin'),\n    \"password\": pm.environment.get('userPassword')",
                  "}, null, 2));",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "pm.execution.setNextRequest(null);",
                  "pm.test('Status HTTP 200', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "if (pm.response.code !== 200) return;",
                  "const body = pm.response.json();",
                  "const valid = typeof body.accessToken === 'string' && body.accessToken.length > 0 && typeof body.refreshToken === 'string' && /^[A-Za-z0-9_-]{43}$/.test(body.refreshToken) && body.tokenType === 'Bearer' && Number.isFinite(Date.parse(body.accessTokenExpiresAt)) && Number.isFinite(Date.parse(body.refreshTokenExpiresAt));",
                  "pm.test('Kontrakt tokenów sesji', function () { pm.expect(valid).to.equal(true); });",
                  "if (!valid) return;",
                  "pm.environment.set('fourMoneyAccessToken', body.accessToken);",
                  "pm.environment.set('fourMoneyRefreshToken', body.refreshToken);",
                  "})();"
                ]
              }
            }
          ],
          "response": []
        },
