                  "    return body.id === pm.environment.get('attemptId') && body.status === 'PENDING'",
                  "        && body.connectionId === null && isDate(body.expiresAt) && publicBody(body);",
                  "});",
                  "pm.execution.setNextRequest(null);",
                  "})();"
