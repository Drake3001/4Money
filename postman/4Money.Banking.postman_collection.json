{
  "info": {
    "name": "4Money — Banking / Tink",
    "description": "Wyłącznie flow integracji Tink. Uruchamiaj etapami według notes/POSTMAN.md. Nie zawiera loginu ani testów innych modułów. Chronione żądania wymagają przyszłego auth 4Money; obecny host zwraca 401. Sekrety i dane procesu wyłącznie w lokalnym środowisku.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{fourMoneyAccessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "10 — Rozpoczęcie połączenia",
      "description": "Uruchom przed otwarciem Tink Link. Runner kończy po PENDING.",
      "item": [
        {
          "name": "11 — Rozpocznij połączenie z bankiem",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/banking/connection-attempts",
            "description": "Wymaga działającego auth 4Money i poprawnej konfiguracji Tink/backendu. Tworzy trwałą próbę. Czyści zmienne poprzedniej próby; nie otwiera URL automatycznie."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "function stop(message) {",
                  "    pm.test('Warunki wstępne', function () { throw new Error(message); });",
                  "    pm.execution.setNextRequest(null);",
                  "    pm.execution.skipRequest();",
                  "}",
                  "function need(names) {",
                  "    const missing = names.filter(function (name) {",
                  "        const value = pm.environment.get(name);",
                  "        return typeof value !== 'string' || !value.trim() || value.includes('{{');",
                  "    });",
                  "    if (missing.length) stop('Uzupełnij lokalne środowisko: ' + missing.join(', '));",
                  "}",
                  "function clear(names) { names.forEach(function (name) { pm.environment.unset(name); }); }",
                  "clear([\"attemptId\", \"attemptExpiresAt\", \"authorizationUrl\", \"callbackState\", \"connectionId\", \"callbackCredentialsId\"]);",
                  "need(['baseUrl', 'fourMoneyAccessToken']);",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "function check(name, predicate) {",
                  "    let ok = false;",
                  "    try { ok = Boolean(predicate()); } catch (_) { /* Do not expose response values. */ }",
                  "    pm.test(name, function () { pm.expect(ok, name).to.equal(true); });",
                  "    if (!ok) {",
                  "        pm.execution.setNextRequest(null);",
                  "        throw new Error('Przerwano: ' + name);",
                  "    }",
                  "}",
                  "function isGuid(value) {",
                  "    return typeof value === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value)",
                  "        && value !== '00000000-0000-0000-0000-000000000000';",
                  "}",
                  "function isDate(value) { return typeof value === 'string' && Number.isFinite(Date.parse(value)); }",
                  "function publicBody(value) {",
                  "    const forbidden = ['clientSecret', 'client_secret', 'accessToken', 'access_token', 'refreshToken', 'refresh_token',",
                  "        'authorizationCode', 'authorization_code', 'tinkUserId', 'credentialsId', 'credentials_id', 'accountIds'];",
                  "    if (Array.isArray(value)) return value.every(publicBody);",
                  "    if (value && typeof value === 'object') return Object.keys(value).every(function (key) {",
                  "        return !forbidden.includes(key) && publicBody(value[key]);",
                  "    });",
                  "    return true;",
                  "}",
                  "function jsonResponse(status, noStore) {",
                  "    check('Oczekiwany status HTTP ' + status, function () { return pm.response.code === status; });",
                  "    check('Odpowiedź JSON', function () {",
                  "        return /application\\/(?:problem\\+)?json/i.test(pm.response.headers.get('Content-Type') || '');",
                  "    });",
                  "    if (noStore) check('Cache-Control: no-store', function () {",
                  "        return /(?:^|,)\\s*no-store\\s*(?:,|$)/i.test(pm.response.headers.get('Cache-Control') || '');",
                  "    });",
                  "    let body;",
                  "    check('Poprawny dokument JSON', function () { body = pm.response.json(); return body !== null; });",
                  "    return body;",
                  "}",
                  "const body = jsonResponse(201, true);",
                  "check('Kontrakt rozpoczęcia i brak danych dostawcy', function () {",
                  "    return isGuid(body.attemptId) && isDate(body.expiresAt) && publicBody(body);",
                  "});",
                  "let link;",
                  "check('Tink Link zawiera kod, state i wymagane parametry', function () {",
                  "    link = new URL(body.authorizationUrl);",
                  "    return link.protocol === 'https:' && link.pathname === '/1.0/transactions/connect-accounts'",
                  "        && ['authorization_code', 'state', 'client_id', 'redirect_uri', 'market', 'locale', 'refreshable_items']",
                  "            .every(function (key) { return Boolean(link.searchParams.get(key)); })",
                  "        && /^[A-Za-z0-9_-]{43}$/.test(link.searchParams.get('state'));",
                  "});",
                  "check('Location wskazuje utworzoną próbę', function () {",
                  "    const location = new URL(pm.response.headers.get('Location'), pm.environment.get('baseUrl'));",
                  "    return location.pathname === '/api/banking/connection-attempts/' + body.attemptId;",
                  "});",
                  "pm.environment.set('attemptId', body.attemptId);",
                  "pm.environment.set('attemptExpiresAt', body.expiresAt);",
                  "pm.environment.set('authorizationUrl', body.authorizationUrl);",
                  "pm.environment.set('callbackState', link.searchParams.get('state'));",
                  "})();"
                ]
              }
            }
          ],
          "response": []
        },
