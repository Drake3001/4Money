# Copy to tools/.env (ignored by Git); use credentials of your Tink test application.
Tink__ClientId=REPLACE_WITH_TINK_APPLICATION_CLIENT_ID_OR_LEAVE_EMPTY_IF_UNUSED
Tink__ClientSecret=REPLACE_WITH_TINK_APPLICATION_CLIENT_SECRET_OR_LEAVE_EMPTY_IF_UNUSED
Tink__ApiBaseUrl=https://api.tink.com

# Example: host=localhost port=5434 dbname=zpi4m_db user=YOUR_USER password=YOUR_PASSWORD
FOURMONEY_DATABASE_DSN=REPLACE_WITH_YOUR_LOCAL_4MONEY_DATABASE_DSN
