# Copy to tools/.env (ignored by Git); use credentials of your Tink test application.
Tink__ClientId=
Tink__ClientSecret=
Tink__ApiBaseUrl=https://api.tink.com

# Optional local 4Money binding. Standard PostgreSQL DSN, not Npgsql syntax.
# Example: host=localhost port=5434 dbname=zpi4m_db user=YOUR_USER password=YOUR_PASSWORD
# Copy credentials from your local API/Compose config; never commit actual values.
FOURMONEY_DATABASE_DSN=
