# Copy to .env and fill in the keys for the services you use.

# Receipt API: Gemini 3.1 Flash-Lite through OpenRouter.
# API keys: https://openrouter.ai/keys
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
EXTRACTION_WORKFLOW=vision_ocr
EXTRACTION_VISION_ROUTING=throughput
EXTRACTION_BIND_ADDRESS=127.0.0.1

# Local OpenRouter experiments; the API model is configured in api.py.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional experiments using Google directly: https://aistudio.google.com/api-keys
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional NVIDIA-hosted Gemma experiments: https://build.nvidia.com/
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
