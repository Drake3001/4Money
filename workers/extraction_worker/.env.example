# Copy to .env in this directory. .env is ignored by Git.
# Get a key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# HTTP API and optional local Gemma experiments (https://openrouter.ai/keys).
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
# HTTP API always uses paid Gemma; OPENROUTER_MODEL below is
# only for local experiments. Inject this file with Docker Compose -- no
# credentials are loaded from disk automatically by api.py.
# EXTRACTION_BIND_ADDRESS=127.0.0.1
EXTRACTION_WORKFLOW=vision_ocr
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional NVIDIA-hosted Gemma prototype endpoint (https://build.nvidia.com/).
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
