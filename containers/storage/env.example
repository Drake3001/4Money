# Copy to .env and replace the example credentials before starting Compose.
STORAGE_BUCKET=receipts
# Local development. For the VM, use its Tailscale IPv4 address instead.
STORAGE_BIND_IP=127.0.0.1
STORAGE_PORT=8333
STORAGE_VOLUME_NAME=zpi4m_storage_data
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=replace_with_local_access_key
STORAGE_SECRET_KEY=replace_with_random_local_secret_key
