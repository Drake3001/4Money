# Copy to containers/local/.env. This is the only env file used by Docker Compose.
# Replace REPLACE_WITH placeholders before starting; clear optional values if unused.
# Never commit containers/local/.env.
# Backend defaults: appsettings.json and appsettings.Development.json.

# Backend. Compose sets service addresses inside Docker.
# Host bind IPs and ports configure access from your computer.
ASPNETCORE_ENVIRONMENT=Development
USERAUTHENTICATION__SIGNINGKEY=REPLACE_WITH_RANDOM_SIGNING_KEY
RECEIPTOCRPROOF__SIGNINGKEY=REPLAC_WITH_RANDOM_SIGNING_KEY
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=5283

# Required while GoogleAuthentication.Enabled is true in appsettings.json.
# Use the real Google web client ID ending in .apps.googleusercontent.com.
GOOGLEAUTHENTICATION__CLIENTID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID_OR_LEAVE_EMPTY_IF_UNUSED

# SMTP for account emails. Fill in a test server to enable delivery.
SMTP__HOST=REPLACE_WITH_SMTP_HOST_NAME
SMTP__USERNAME=REPLACE_WITH_SMTP_USERNAME_OR_LEAVE_EMPTY_IF_NO_AUTH
SMTP__PASSWORD=REPLACE_WITH_SMTP_PASSWORD_OR_LEAVE_EMPTY_IF_NO_AUTH

# Tink. Register the callback from appsettings.Development.json in Tink Console.
TINK__CLIENTID=REPLACE_WITH_TINK_APPLICATION_CLIENT_ID_OR_LEAVE_EMPTY_IF_UNUSED
TINK__CLIENTSECRET=REPLACE_WITH_TINK_APPLICATION_CLIENT_SECRET_OR_LEAVE_EMPTY_IF_UNUSED

# PostgreSQL. Existing volumes retain their original credentials.
POSTGRES_USER=REPLACE_WITH_PRIVATE_POSTGRES_USERNAME
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_POSTGRES_PASSWORD
POSTGRES_DB=zpi4m_db
POSTGRES_VOLUME_NAME=zpi4m_zpi4m_pgdata
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5434

# SeaweedFS. Both backend and storage use these credentials.
STORAGE__BUCKET=fourmoney-images
STORAGE__ACCESSKEY=REPLACE_WITH_SEAWEEDFS_S3_ACCESS_KEY_ID
STORAGE__SECRETKEY=REPLACE_WITH_RANDOM_SEAWEEDFS_S3_SECRET_ACCESS_KEY
STORAGE_VOLUME_NAME=zpi4m_storage_data
STORAGE_BIND_IP=127.0.0.1
STORAGE_PORT=8333

# Frontend development server. Polling supports Windows bind mounts.
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_USE_POLLING=true

# OCR worker. OPENROUTER_API_KEY is required for the default OCR workflow.
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY_REQUIRED_FOR_DEFAULT_OCR
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
EXTRACTION_WORKFLOW=vision_ocr
EXTRACTION_VISION_ROUTING=throughput
EXTRACTION_BIND_ADDRESS=127.0.0.1
EXTRACTION_PORT=8000
EXTRACTION_VOLUME_NAME=extraction_worker_model_cache
EXTRACTION_MAX_FILE_BYTES=20971520
EXTRACTION_MAX_REQUEST_BYTES=52428800
EXTRACTION_MAX_PAGE_PIXELS=50000000
EXTRACTION_MAX_DOCUMENT_PIXELS=100000000
# Optional providers for experiments and alternative workflows.
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_GEMINI_API_KEY_OR_LEAVE_EMPTY_IF_UNUSED
NVIDIA_API_KEY=REPLACE_WITH_NVIDIA_API_KEY_OR_LEAVE_EMPTY_IF_UNUSED
