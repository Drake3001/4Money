# Add storage settings to the existing .env; preserve database configuration.
# Match bucket and credentials with containers/storage/.env.
STORAGE_ENDPOINT=http://127.0.0.1:8333
# Optional browser-facing origin for signed URLs, when different from STORAGE_ENDPOINT.
# STORAGE_PUBLIC_ENDPOINT=http://localhost:8333
STORAGE_BUCKET=receipts
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=replace_with_local_access_key
STORAGE_SECRET_KEY=replace_with_random_local_secret_key
STORAGE_URL_EXPIRATION_MINUTES=15

# Required OCR service origin (example only); no authentication.
OCR_BASE_URL=http://127.0.0.1:8000
OCR_TIMEOUT_SECONDS=120
# Copy to .env. Run dotnet from this directory.
# Match Username/Password to containers/.env; the host port is 5434.
DB_LOCAL_CONNECTION_STRING=Host=localhost;Port=5434;Database=zpi4m_db;Username=zpi4m_local;Password=REPLACE_WITH_LOCAL_PASSWORD

# Required at startup. Generate a private random key of at least 32 characters.
USERAUTHENTICATION__SIGNINGKEY=REPLACE_WITH_RANDOM_SIGNING_KEY_AT_LEAST_32_CHARACTERS

# Backend-only credentials of your Tink test application. Leave empty for DB setup.
TINK__CLIENTID=
TINK__CLIENTSECRET=
TINK__REDIRECTURI=https://localhost:7278/api/banking/tink/callback
# The redirect must exactly match the URI registered in Tink Console.
# Enable only after verifying product access, scopes and callback configuration.
TINK__CONTINUOUSACCESSVERIFIED=false
BANKING__ATTEMPTLIFETIMEMINUTES=15

# SMTP server for account emails. Replace placeholders with local settings.
SMTP__HOST=smtp.example.com
SMTP__PORT=587
SMTP__SECURITYMODE=StartTls
SMTP__CHECKCERTIFICATEREVOCATION=true
# Set both credentials, or leave both empty for a server without authentication.
SMTP__USERNAME=
SMTP__PASSWORD=
SMTP__SENDEREMAIL=noreply@example.com
SMTP__SENDERNAME=4Money
SMTP__TIMEOUTSECONDS=30
