# Copy to .env. Run dotnet from this directory.
# Match Username/Password to containers/.env; the host port is 5434.
DB_LOCAL_CONNECTION_STRING=Host=localhost;Port=5434;Database=zpi4m_db;Username=zpi4m_local;Password=REPLACE_WITH_LOCAL_PASSWORD

# Required at startup. Generate a private random key of at least 32 characters.
UserAuthentication__SigningKey=REPLACE_WITH_RANDOM_SIGNING_KEY_AT_LEAST_32_CHARACTERS

# Backend-only credentials of your Tink test application. Leave empty for DB setup.
Tink__ClientId=
Tink__ClientSecret=
Tink__RedirectUri=https://localhost:7278/api/banking/tink/callback
# The redirect must exactly match the URI registered in Tink Console.
# Enable only after verifying product access, scopes and callback configuration.
Tink__ContinuousAccessVerified=false
Banking__AttemptLifetimeMinutes=15
