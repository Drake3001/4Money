# Local API credentials. Non-secret defaults are in appsettings.json.
# Copy to .env.
# Replace REPLACE_WITH placeholders before starting; clear optional values if unused.
# Never commit .env. Docker uses containers/local/.env instead.

# PostgreSQL. Existing volumes retain their original credentials.
DB_LOCAL_CONNECTION_STRING=Host=localhost;Port=5434;Database=zpi4m_db;Username=REPLACE_WITH_PRIVATE_POSTGRES_USERNAME;Password=REPLACE_WITH_PRIVATE_POSTGRES_PASSWORD

# Backend.
USERAUTHENTICATION__SIGNINGKEY=REPLACE_WITH_RANDOM_SIGNING_KEY_AT_LEAST_32_CHARACTERS

# Tink. Register this exact callback in Tink Console.
# Use the externally reachable callback address when testing outside localhost.
TINK__CLIENTID=REPLACE_WITH_TINK_APPLICATION_CLIENT_ID_OR_LEAVE_EMPTY_IF_UNUSED
TINK__CLIENTSECRET=REPLACE_WITH_TINK_APPLICATION_CLIENT_SECRET_OR_LEAVE_EMPTY_IF_UNUSED

# SMTP for account emails. Fill in a test server to enable delivery.
SMTP__USERNAME=REPLACE_WITH_SMTP_USERNAME_OR_LEAVE_EMPTY_IF_NO_AUTH
SMTP__PASSWORD=REPLACE_WITH_SMTP_PASSWORD_OR_LEAVE_EMPTY_IF_NO_AUTH
SMTP__SENDEREMAIL=REPLACE_WITH_SMTP_SENDER_EMAIL

# SeaweedFS. Both backend and storage use these credentials.
STORAGE_ACCESS_KEY=REPLACE_WITH_SEAWEEDFS_S3_ACCESS_KEY_ID
STORAGE_SECRET_KEY=REPLACE_WITH_RANDOM_SEAWEEDFS_S3_SECRET_ACCESS_KEY
