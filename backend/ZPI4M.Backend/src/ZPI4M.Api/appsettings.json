{
  "LimitsAlerts": {
    "WarningThresholdPercent": 80
  },
  "LimitsAlertsSweep": {
    "Enabled": true,
    "RunOnStartup": true,
    "IntervalSeconds": 60,
    "RunTimeoutSeconds": 300,
    "MaxDefinitionsPerRun": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GoogleAuthentication": {
    "Enabled": true,
    "ChallengeLifetimeMinutes": 5,
    "MaxPendingChallenges": 10000,
    "HttpTimeoutSeconds": 10
  },
  "Smtp": {
    "Port": 587,
    "SecurityMode": "StartTls",
    "CheckCertificateRevocation": true,
    "SenderEmail": "noreply@4money.com.pl",
    "SenderName": "4Money",
    "TimeoutSeconds": 30
  },
  "Tink": {
    "ContinuousAccessVerified": true,
    "ActorClientId": "df05e4b379934cd09963197cc855bfe9",
    "ApiBaseUrl": "https://api.tink.com/",
    "LinkUrl": "https://link.tink.com/1.0/transactions/connect-accounts",
    "Market": "PL",
    "Locale": "en_US",
    "ClientScopes": [
      "authorization:grant"
    ],
    "DelegatedScopes": [
      "accounts:read",
      "authorization:grant",
      "authorization:read",
      "credentials:read",
      "credentials:refresh",
      "credentials:write",
      "providers:read",
      "user:read"
    ],
    "RefreshableItems": [
      "CHECKING_ACCOUNTS",
      "CHECKING_TRANSACTIONS",
      "SAVING_ACCOUNTS",
      "SAVING_TRANSACTIONS",
      "CREDITCARD_ACCOUNTS",
      "CREDITCARD_TRANSACTIONS"
    ]
  },
  "Banking": {
    "AttemptLifetimeMinutes": 15,
    "Refresh": {
      "InitialHistoryDays": 30,
      "OverlapDays": 7,
      "MaxAttempts": 3,
      "FirstRetrySeconds": 30,
      "SubsequentRetrySeconds": 120,
      "AttemptTimeoutMinutes": 10,
      "PollSeconds": 2,
      "LeaseSeconds": 120,
      "HeartbeatSeconds": 30,
      "MaxPages": 10000
    }
  },
  "Storage": {
    "Region": "us-east-1",
    "UrlExpirationMinutes": 15,
    "UserIconPresetPrefix": "icons/presets/users/",
    "GroupIconPresetPrefix": "icons/presets/groups/",
    "ReceiptStoragePrefix": "receipts/"
  },
  "Ocr": {
    "TimeoutSeconds": 120
  }
}
