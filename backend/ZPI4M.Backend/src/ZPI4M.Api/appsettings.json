{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GoogleAuthentication": {
    "Enabled": false,
    "ClientId": "",
    "ChallengeLifetimeMinutes": 5,
    "MaxPendingChallenges": 10000,
    "HttpTimeoutSeconds": 10
  },
  "Tink": {
    "RedirectUri": "https://localhost:7278/api/banking/tink/callback",
    "ContinuousAccessVerified": false,
    "ActorClientId": "df05e4b379934cd09963197cc855bfe9",
    "ApiBaseUrl": "https://api.tink.com/",
    "LinkUrl": "https://link.tink.com/1.0/transactions/connect-accounts",
    "Market": "PL",
    "Locale": "en_US",
    "ClientScopes": [
      "authorization:grant"
    ],
    "DelegatedScopes": [
      "accounts:read",
      "authorization:grant",
      "authorization:read",
      "credentials:read",
      "credentials:refresh",
      "credentials:write",
      "providers:read",
      "user:read"
    ],
    "RefreshableItems": [
      "CHECKING_ACCOUNTS",
      "CHECKING_TRANSACTIONS",
      "SAVING_ACCOUNTS",
      "SAVING_TRANSACTIONS",
      "CREDITCARD_ACCOUNTS",
      "CREDITCARD_TRANSACTIONS"
    ]
  },
  "Banking": {
    "AttemptLifetimeMinutes": 15,
    "Refresh": {
      "InitialHistoryDays": 30,
      "OverlapDays": 7,
      "MaxAttempts": 3,
      "FirstRetrySeconds": 30,
      "SubsequentRetrySeconds": 120,
      "AttemptTimeoutMinutes": 10,
      "PollSeconds": 2,
      "LeaseSeconds": 120,
      "HeartbeatSeconds": 30,
      "MaxPages": 10000
    }
  },
  "Smtp": {
    "Host": "poczta.o2.pl",
    "Port": 465,
    "SecurityMode": "SslOnConnect",
    "CheckCertificateRevocation": false,
    "SenderName": "4Money",
    "TimeoutSeconds": 30
  },
  "STORAGE_BUCKET": "receipts",
  "STORAGE_REGION": "us-east-1",
  "STORAGE_URL_EXPIRATION_MINUTES": 15,
  "STORAGE_ENDPOINT": "http://127.0.0.1:8333",
  "OCR_TIMEOUT_SECONDS": 120,
  "OCR_BASE_URL": "http://127.0.0.1:8000"
